{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vitepress",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": ".vitepress/dist",
  "cleanUrls": true,
  "bunVersion": "1.4.x",
  "rewrites": [{ "source": "/api/:path*", "destination": "/api/server" }],
  "redirects": [{ "source": "/docs/starter-requirement.pdf", "destination": "/api/files/requirement.pdf", "permanent": false }],
  "headers": [
    {
      "source": "/(starter|steps|dev|login|no-access)(.*)",
      "headers": [{ "key": "Cache-Control", "value": "private, no-store" }]
    }
  ]
}
