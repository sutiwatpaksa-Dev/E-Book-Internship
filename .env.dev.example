# ===== ค่าตั้งของ Dev (Vercel Preview · branch dev) =====
# วิธีใช้:
#   1. คัดลอกไฟล์นี้เป็น .env.preview   (Git Bash / Mac: cp .env.dev.example .env.preview)
#      .env.preview ไม่ขึ้น git (อยู่ใน .gitignore) ค่าลับอยู่ในเครื่องเราเท่านั้น
#   2. กรอกค่าที่บรรทัดที่ไม่มี # นำหน้า · ห้ามใส่เครื่องหมายคำพูด " ' และห้ามมีช่องว่างหลังค่า
#   3. ใส่ใน Vercel: Settings → Environment Variables → Add → วางทั้งไฟล์ลงช่อง Key
#      (Vercel แยกเป็นหลายตัวแปรให้เอง) → Environments เลือกเฉพาะ Preview, Branch = dev → Save
#      แล้วกด Redeploy ที่ deployment ล่าสุดของ dev
#   4. ใช้กับสคริปต์ในเครื่องได้ด้วย เช่น  bun --env-file=.env.preview scripts/set-super-admin.ts <ชื่อ>

# --- จำเป็น (ขาดตัวไหน API ตอบ 503 "ระบบยังตั้งค่าไม่ครบ") ---

# ฐานข้อมูลของ preview (ต้องไม่ใช่ฐานเดียวกับ main)
# เอาจาก Neon → Branches → เลือก branch ของ dev → Connect → คัดลอก connection string
# รูปแบบ: postgresql://<user>:<password>@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# กุญแจเซ็นบัตรผ่าน ยาว 32 ตัวขึ้นไป · สร้างด้วย: openssl rand -hex 32
# ใช้คนละค่ากับ main · เปลี่ยนเมื่อไหร่ ทุกคนบน preview ต้อง login ใหม่ (ไม่เสียข้อมูล)
SESSION_SECRET=

# URL ของเว็บ preview เอง (ด่านกันคำขอปลอมจากเว็บอื่น) · ไม่ต้องมี / ท้าย
APP_ORIGIN=https://e-book-internship-git-dev-mao-ji.vercel.app

# --- ไม่บังคับ ---

# repo ตัวอย่างระบบจริงที่น้องเห็นหลัง login
# EXAMPLE_REPO_URL=https://github.com/<org>/<example-repo>

# --- ใช้ครั้งเดียวตอนเริ่มระบบ แล้วลบออกจาก Vercel ---

# สร้างบัญชีพี่เลี้ยง + Super admin ให้เองตอน login ครั้งแรก (ถ้ายังไม่มีชื่อนี้ในฐาน)
# PIN = ตัวเลข 6 หลักพอดี · login ได้แล้วให้ "ออก PIN ใหม่" ให้ตัวเอง แล้วลบทั้งสองตัวออก
# FIRST_DEV_USERNAME=superadmin
# FIRST_DEV_PIN=

# ตั้งบัญชีพี่เลี้ยงที่ "มีอยู่แล้ว" เป็น Super admin (ใช้ได้เฉพาะตอนฐานยังไม่มี Super admin)
# FIRST_SUPER_ADMIN=
